# Intuit Developer app credentials (production)
INTUIT_CLIENT_ID=
INTUIT_CLIENT_SECRET=

# Your QBO company's realm ID (auto-filled after first OAuth flow if blank)
INTUIT_REALM_ID=

# OAuth redirect URI — must match what's registered in your Intuit app exactly
INTUIT_REDIRECT_URI=http://localhost:8080/callback

# Auto-filled by `tiktok_qbo auth` after first OAuth flow
INTUIT_REFRESH_TOKEN=

# 'production' or 'sandbox'
INTUIT_ENVIRONMENT=production
